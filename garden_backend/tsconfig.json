{
  "compilerOptions": {
    "target": "ES6",  // Kompilace na ES6 (dobré pro Node.js a moderní JavaScript)
    "module": "CommonJS",  // Používáme CommonJS moduly pro Node.js
    "outDir": "./dist",  // Kde budou uloženy přeložené soubory
    "rootDir": "./src",  // Kořenový adresář pro tvé TypeScript soubory
    "strict": true,  // Povolení přísné kontroly typů
    "esModuleInterop": true,  // Podpora pro importy ES modulů
    "skipLibCheck": true,  // Nepovinná kontrola typů v knihovnách (pro zrychlení kompilace)
    "forceConsistentCasingInFileNames": true  // Zajištění konzistentního používání velkých/malých písmen
  },
  "include": ["src/**/*"],  // Všechny soubory ve složce src
  "exclude": ["node_modules", "dist"]  // Vylučujeme node_modules a dist z kompilace
}
